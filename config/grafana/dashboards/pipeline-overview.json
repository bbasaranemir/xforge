    {
      "title": "Players",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "PostgreSQL",
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS total FROM dim_players;",
        "format": "table"
